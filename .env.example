# Frontend (safe to expose: the anon key is protected by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Require TOTP MFA for Super Admin and HOD (set to "false" only for local development)
VITE_ENFORCE_MFA=true

# Edge Function secrets are set with `supabase secrets set` - NEVER in the frontend:
#   SITE_URL=https://your-domain
#   ALLOWED_ORIGINS=https://your-domain
#   IP_SALT=<random string>
#   ANTHROPIC_API_KEY=<optional, for AI narrative drafts>
#   ANTHROPIC_MODEL=claude-sonnet-5-5
